# Deterministic, least-privilege install for the isolated contract-validation toolchain.
# ignore-scripts: no dependency lifecycle (pre/post-install) scripts execute — removes
#   arbitrary-code-execution surface at install time. None of the pinned validators need them.
# save-exact: every dependency is pinned to an exact version (no ^ / ~ drift).
ignore-scripts=true
save-exact=true
fund=false
audit=false
