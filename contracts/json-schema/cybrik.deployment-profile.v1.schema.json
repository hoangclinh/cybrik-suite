{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cybrik.deployment-profile.v1.schema.json",
  "title": "CYBRIK Deployment Profile v1",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^(?!^(T0|T1|T2)$)[a-z0-9][a-z0-9-_]+$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$"
    },
    "capability_set": {
      "type": "object",
      "properties": {
        "oci_container_runtime": {
          "type": "string"
        },
        "isolation_substrate": {
          "type": "string"
        },
        "orchestration_capability": {
          "type": "string"
        },
        "network_segmentation": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "cache": {
          "type": "string"
        },
        "secrets": {
          "type": "string"
        },
        "crypto": {
          "type": "string"
        },
        "identity_workload_identity": {
          "type": "string"
        },
        "observability": {
          "type": "string"
        },
        "ai_model_runtime": {
          "type": "string"
        },
        "artifact_update_mechanism": {
          "type": "string"
        }
      },
      "required": [
        "oci_container_runtime",
        "isolation_substrate",
        "orchestration_capability",
        "network_segmentation",
        "storage",
        "database",
        "cache",
        "secrets",
        "crypto",
        "identity_workload_identity",
        "observability",
        "ai_model_runtime",
        "artifact_update_mechanism"
      ]
    },
    "strength": {
      "type": "object",
      "properties": {
        "oci_container_runtime": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "isolation_substrate": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "orchestration_capability": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "network_segmentation": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "storage": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "database": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "cache": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "secrets": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "crypto": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "identity_workload_identity": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "observability": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "ai_model_runtime": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        },
        "artifact_update_mechanism": {
          "type": "string",
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        }
      },
      "required": [
        "oci_container_runtime",
        "isolation_substrate",
        "orchestration_capability",
        "network_segmentation",
        "storage",
        "database",
        "cache",
        "secrets",
        "crypto",
        "identity_workload_identity",
        "observability",
        "ai_model_runtime",
        "artifact_update_mechanism"
      ]
    },
    "sovereignty_class": {
      "type": "string",
      "enum": [
        "SOVEREIGN_CUSTOMER_CONTROLLED",
        "CONTROLLED_CROSS_DOMAIN",
        "OPTIONAL_HYBRID"
      ]
    },
    "isolation_floor": {
      "type": "string",
      "enum": [
        "standard_container",
        "gvisor_runsc",
        "firecracker_jailer",
        "kata_runtime_class"
      ]
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "capability_set",
    "strength",
    "sovereignty_class",
    "isolation_floor"
  ]
}