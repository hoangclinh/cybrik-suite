{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cybrik.example/json-schema/cybrik.receipt-trust-bundle.v1.schema.json",
  "title": "CYBRIK receipt verifier trust bundle",
  "description": "ACCEPTED FOR IMPLEMENTATION — NOT IMPLEMENTED. Public verification material and lifecycle metadata only; bundle_uri is never a fetch instruction.",
  "x-cybrik-status": "ACCEPTED FOR IMPLEMENTATION — NOT IMPLEMENTED",
  "x-cybrik-not-accepted": false,
  "x-cybrik-not-implemented": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_uri", "generation", "generated_at", "not_after", "max_staleness_seconds", "keys"],
  "properties": {
    "schema": { "const": "cybrik.receipt-trust-bundle@0.1.0" },
    "bundle_uri": { "const": "cybrik-trust://receipt-signers/v1" },
    "generation": { "type": "integer", "minimum": 1 },
    "predecessor_generation": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "not_after": { "type": "string", "format": "date-time" },
    "max_staleness_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kid", "kty", "crv", "x", "state", "not_before", "not_after"],
        "properties": {
          "kid": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "kty": { "const": "OKP" },
          "crv": { "const": "Ed25519" },
          "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "state": { "enum": ["active", "retiring", "retired", "revoked"] },
          "not_before": { "type": "string", "format": "date-time" },
          "not_after": { "type": "string", "format": "date-time" },
          "revoked_at": { "type": "string", "format": "date-time" },
          "revocation_reason": { "enum": ["key_compromise", "signer_decommissioned", "superseded", "operational_error"] },
          "revocation_effective": { "enum": ["from_revocation_time", "retroactive_all"] }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "revoked" } }, "required": ["state"] },
            "then": {
              "properties": {
                "revoked_at": true,
                "revocation_reason": true,
                "revocation_effective": true
              },
              "required": ["revoked_at", "revocation_reason", "revocation_effective"]
            },
            "else": {
              "properties": {
                "revoked_at": false,
                "revocation_reason": false,
                "revocation_effective": false
              }
            }
          }
        ]
      }
    }
  }
}
