{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cybrik.example/cybrik.provider-capability-advertisement.v1.schema.json",
  "x-cybrik-status": "PROPOSED",
  "x-cybrik-not-accepted": true,
  "x-cybrik-contract-version": "0.1.0",
  "$comment": "Status: PROPOSED. Architectural Platform Contract Proposal v1.0.0.",
  "title": "CYBRIK Provider Capability Advertisement v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_profile_id": {
      "type": "string",
      "enum": [
        "onprem-standard-v1",
        "onprem-airgap-v1",
        "private-cloud-v1",
        "hybrid-sovereign-v1"
      ]
    },
    "target_profile_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "provider_namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]*[a-z0-9]$",
      "minLength": 2
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "PARTIAL_CAPABILITY_ADVERTISEMENT",
        "FULL_PROFILE_CONFORMANCE_DECLARATION"
      ]
    },
    "advertised_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "minLength": 2
          },
          "slot_id": {
            "type": "string",
            "enum": [
              "oci_container_runtime",
              "isolation_substrate",
              "orchestration_capability",
              "network_segmentation",
              "storage",
              "database",
              "cache",
              "secrets",
              "crypto",
              "identity_workload_identity",
              "observability",
              "ai_model_runtime",
              "artifact_update_mechanism"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "pattern": "\\S+"
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "capability_name",
          "slot_id",
          "description",
          "evidence_references"
        ]
      }
    },
    "conformance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_identifier": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S+"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "AUTOMATED_TEST",
              "STATIC_ANALYSIS",
              "BENCHMARK"
            ]
          },
          "report_uri": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S+"
          }
        },
        "required": [
          "test_identifier",
          "verification_method",
          "report_uri"
        ]
      },
      "uniqueItems": true
    },
    "degradation_behavior": {
      "const": "FAIL_CLOSED"
    },
    "authenticated_discovery": {
      "const": true
    }
  },
  "required": [
    "target_profile_id",
    "target_profile_version",
    "provider_namespace",
    "claim_type",
    "advertised_capabilities",
    "conformance_evidence",
    "degradation_behavior",
    "authenticated_discovery"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "FULL_PROFILE_CONFORMANCE_DECLARATION"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "oci_container_runtime"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "isolation_substrate"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "orchestration_capability"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "network_segmentation"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "storage"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "database"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "cache"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "secrets"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "crypto"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "identity_workload_identity"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "observability"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "ai_model_runtime"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "artifact_update_mechanism"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "advertised_capabilities": {
            "maxItems": 13
          }
        }
      }
    }
  ],
  "x-cybrik-lifecycle": "PROPOSED"
}
