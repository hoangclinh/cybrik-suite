{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cybrik.example/cybrik.provider-capability-advertisement.v1.schema.json",
  "x-cybrik-status": "PROPOSED",
  "x-cybrik-not-accepted": true,
  "x-cybrik-contract-version": "0.1.0",
  "$comment": "Status: PROPOSED. Architectural Platform Contract Proposal v1.0.0.",
  "title": "CYBRIK Provider Capability Advertisement v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_profile_id": {
      "type": "string",
      "pattern": "^(?!^[tT][012]$)[a-z0-9][a-z0-9-_]+$"
    },
    "target_profile_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "provider_namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]*[a-z0-9]$",
      "minLength": 2
    },
    "advertised_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "minLength": 2
          },
          "slot_id": {
            "type": "string",
            "enum": [
              "oci_container_runtime",
              "isolation_substrate",
              "orchestration_capability",
              "network_segmentation",
              "storage",
              "database",
              "cache",
              "secrets",
              "crypto",
              "identity_workload_identity",
              "observability",
              "ai_model_runtime",
              "artifact_update_mechanism"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "pattern": "\\S+"
          }
        },
        "required": [
          "capability_name",
          "slot_id",
          "description"
        ]
      }
    },
    "conformance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_identifier": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S+"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "AUTOMATED_TEST",
              "STATIC_ANALYSIS",
              "BENCHMARK"
            ]
          },
          "report_uri": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S+"
          }
        },
        "required": [
          "test_identifier",
          "verification_method",
          "report_uri"
        ]
      }
    },
    "degradation_behavior": {
      "type": "string",
      "enum": [
        "FAIL_CLOSED",
        "EXPLICIT_FALLBACK"
      ]
    },
    "authenticated_discovery": {
      "const": true
    }
  },
  "required": [
    "target_profile_id",
    "target_profile_version",
    "provider_namespace",
    "advertised_capabilities",
    "conformance_evidence",
    "degradation_behavior",
    "authenticated_discovery"
  ],
  "x-cybrik-lifecycle": "PROPOSED"
}
