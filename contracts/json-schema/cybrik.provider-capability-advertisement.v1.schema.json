{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cybrik.example/cybrik.provider-capability-advertisement.v1.schema.json",
  "x-cybrik-status": "ACCEPTED FOR IMPLEMENTATION",
  "x-cybrik-not-accepted": false,
  "x-cybrik-contract-version": "0.1.0",
  "$comment": "Status: PROPOSED. Architectural Platform Contract Proposal v1.0.0.",
  "title": "CYBRIK Provider Capability Advertisement v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_profile_id": {
      "type": "string",
      "pattern": "^(?!^[tT][012]$)[a-z0-9][a-z0-9-_]+$"
    },
    "target_profile_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "provider_namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]*[a-z0-9]$",
      "minLength": 2
    },
    "advertised_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_name": { "type": "string" },
          "slot_id": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": [ "capability_name", "slot_id", "description" ]
      }
    },
    "conformance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_identifier": { "type": "string" },
          "verification_method": { "type": "string" },
          "report_uri": { "type": "string" }
        },
        "required": [ "test_identifier", "verification_method", "report_uri" ]
      }
    },
    "degradation_behavior": {
      "const": "FAIL_CLOSED"
    },
    "authenticated_discovery": {
      "const": true
    }
  },
  "required": [
    "target_profile_id",
    "target_profile_version",
    "provider_namespace",
    "advertised_capabilities",
    "conformance_evidence",
    "degradation_behavior",
    "authenticated_discovery"
  ]
}
