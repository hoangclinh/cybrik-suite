{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cybrik.example/cybrik.provider-capability-advertisement.v1.schema.json",
  "x-cybrik-status": "PROPOSED",
  "x-cybrik-not-accepted": true,
  "x-cybrik-contract-version": "0.1.0",
  "$comment": "CYBRIK Suite Contract Proposal v0.1.0-proposed",
  "title": "CYBRIK Provider Capability Advertisement v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "s3OperationName": {
      "type": "string",
      "enum": [
        "PutObject",
        "GetObject",
        "HeadObject",
        "DeleteObject",
        "DeleteObjects",
        "ListObjectsV2",
        "HeadBucket",
        "CreateBucket",
        "CreateMultipartUpload",
        "UploadPart",
        "CompleteMultipartUpload",
        "AbortMultipartUpload",
        "ListParts",
        "PutBucketVersioning",
        "GetBucketVersioning",
        "PutObjectRetention",
        "GetObjectRetention",
        "PutObjectLegalHold",
        "GetObjectLegalHold"
      ]
    },
    "capabilityDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_name": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 2
        },
        "slot_id": {
          "type": "string",
          "enum": [
            "oci_container_runtime",
            "isolation_substrate",
            "orchestration_capability",
            "network_segmentation",
            "storage",
            "database",
            "cache",
            "secrets",
            "crypto",
            "identity_workload_identity",
            "observability",
            "ai_model_runtime",
            "artifact_update_mechanism"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "pattern": "\\S+"
        },
        "is_mandatory": {
          "type": "boolean"
        },
        "supported_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S+"
          }
        },
        "degradation_fallback": {
          "type": "string",
          "enum": [
            "NONE",
            "CORE_EMULATION_FALLBACK",
            "FEATURE_DISABLED_GRACEFUL"
          ]
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^urn:cybrik:evidence:[a-z0-9][a-z0-9-_:]*[a-z0-9]$"
          }
        }
      },
      "required": [
        "capability_name",
        "slot_id",
        "description",
        "is_mandatory",
        "supported_features",
        "degradation_fallback",
        "evidence_references"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "slot_id": {
                "const": "storage"
              }
            }
          },
          "then": {
            "properties": {
              "supported_features": {
                "items": {
                  "$ref": "#/$defs/s3OperationName"
                }
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "target_profile_id": {
      "type": "string",
      "enum": [
        "onprem-standard-v1",
        "onprem-airgap-v1",
        "private-cloud-v1",
        "hybrid-sovereign-v1"
      ]
    },
    "target_profile_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "target_profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]*[a-z0-9]$",
      "minLength": 2
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "PARTIAL_CAPABILITY_ADVERTISEMENT",
        "FULL_PROFILE_CONFORMANCE_DECLARATION"
      ]
    },
    "advertised_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capabilityDescriptor"
      }
    },
    "conformance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_identifier": {
            "type": "string",
            "pattern": "^urn:cybrik:evidence:[a-z0-9][a-z0-9-_:]*[a-z0-9]$"
          },
          "status": {
            "const": "PASS"
          },
          "evidence_pack_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          },
          "report_uri": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "test_identifier",
          "status",
          "evidence_pack_digest"
        ]
      },
      "uniqueItems": true
    },
    "degradation_behavior": {
      "const": "FAIL_CLOSED"
    },
    "authenticated_discovery": {
      "const": true
    }
  },
  "required": [
    "target_profile_id",
    "target_profile_version",
    "target_profile_digest",
    "provider_namespace",
    "claim_type",
    "advertised_capabilities",
    "conformance_evidence",
    "degradation_behavior",
    "authenticated_discovery"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "FULL_PROFILE_CONFORMANCE_DECLARATION"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "advertised_capabilities": {
                "minItems": 13,
                "maxItems": 13,
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "oci_container_runtime"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "isolation_substrate"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "orchestration_capability"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "network_segmentation"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "storage"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "database"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "cache"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "secrets"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "crypto"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "identity_workload_identity"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "observability"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "ai_model_runtime"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "advertised_capabilities": {
                "contains": {
                  "properties": {
                    "slot_id": {
                      "const": "artifact_update_mechanism"
                    }
                  },
                  "required": [
                    "slot_id"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "advertised_capabilities": {
            "maxItems": 13
          }
        }
      }
    }
  ],
  "x-cybrik-lifecycle": "PROPOSED",
  "description": "CYBRIK Provider Capability Advertisement v1 [PROPOSED_SUBORDINATE_CONTRACT_ARTIFACT]"
}
