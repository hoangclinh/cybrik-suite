          "type": "boolean",
          "const": true
        },
        "sig_v4": {
          "type": "boolean",
          "const": true
        },
        "path_style_access": {
          "type": "boolean",
          "const": true
        },
        "versioning": {
          "type": "boolean",
          "const": true
        },
        "error_mappings": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "supported_optional_features": {
      "type": "object",
