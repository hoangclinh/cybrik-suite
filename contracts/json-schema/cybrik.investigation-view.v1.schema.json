{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cybrik.example/json-schema/cybrik.investigation-view.v1.schema.json",
  "title": "CYBRIK Investigation Workspace View Contract Schema v1",
  "description": "JSON Schema Draft 2020-12 defining SOC Investigation Workspace views, aggregated timeline events, graph nodes and relationships, verifiable evidence citations, and report exports (Pillars 3, 4, 5, 8, 10). Governs interactive analyst workspaces, multi-source event correlation timelines, entity relationship graphs, cryptographic provenance citations, and formal investigation reporting.",
  "x-cybrik-status": "ACCEPTED FOR IMPLEMENTATION",
  "x-cybrik-not-accepted": false,
  "x-cybrik-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "view_id",
    "investigation_id",
    "tenant_id",
    "title",
    "status",
    "created_by",
    "timeline_events",
    "graph",
    "citations",
    "report_export",
    "data_marking",
    "created_at",
    "updated_at",
    "digest"
  ],
  "properties": {
    "view_id": {
      "type": "string",
      "description": "Canonical investigation view or workspace identifier.",
      "pattern": "^(view|ws)_[a-zA-Z0-9._:-]{8,64}$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "investigation_id": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/uuid",
      "description": "Parent investigation UUID to which this workspace view belongs."
    },
    "tenant_id": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/tenantId",
      "description": "Authoritative tenant identifier governing workspace access."
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the investigation workspace view.",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "description": "Operational status of the investigation workspace view.",
      "enum": ["ACTIVE", "REVIEWING", "RESOLVED", "ARCHIVED", "ESCALATED"]
    },
    "created_by": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/actor",
      "description": "Analyst or automated agent who generated or curated this view."
    },
    "timeline_events": {
      "type": "array",
      "description": "Chronologically aggregated security events across telemetry sources.",
      "items": {
        "$ref": "#/$defs/timelineEvent"
      },
      "minItems": 1
    },
    "graph": {
      "$ref": "#/$defs/workspaceGraph",
      "description": "Entity relationship graph representing IOCs, assets, alerts, and observed connections."
    },
    "citations": {
      "type": "array",
      "description": "Verifiable cryptographic citations grounding all claims and timeline entries in source telemetry.",
      "items": {
        "$ref": "#/$defs/verifiableCitation"
      },
      "minItems": 1
    },
    "report_export": {
      "$ref": "#/$defs/reportExport",
      "description": "Formal investigation report artifact export."
    },
    "layout": {
      "type": "object",
      "description": "UI layout and workspace visual configuration state.",
      "additionalProperties": false,
      "properties": {
        "active_tab": { "type": "string" },
        "zoom_level": { "type": "number", "minimum": 0.1, "maximum": 5.0 },
        "selected_node_ids": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "data_marking": {
      "$ref": "cybrik.data-marking.v1.schema.json",
      "description": "Authoritative data marking and TLP classification."
    },
    "created_at": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/timestampUtc"
    },
    "updated_at": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/timestampUtc"
    },
    "digest": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/sha256Digest",
      "description": "SHA-256 digest over the canonical JSON representation of the workspace view."
    }
  },
  "$defs": {
    "timelineEvent": {
      "type": "object",
      "description": "Normalized timeline event aggregated within the investigation workspace.",
      "additionalProperties": false,
      "required": [
        "event_id",
        "timestamp",
        "event_type",
        "title",
        "severity",
        "source",
        "entity_ids"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "cybrik.common-defs.v1.schema.json#/$defs/timestampUtc"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "ALERT_TRIGGERED",
            "PROCESS_EXECUTION",
            "NETWORK_BEACON",
            "FILE_MODIFICATION",
            "USER_AUTHENTICATION",
            "PRIVILEGE_ESCALATION",
            "ANALYST_ACTION",
            "CONTAINMENT_TRIGGERED",
            "IOC_DETECTION"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["INFORMATIONAL", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "entity_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_citations": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "graphNode": {
      "type": "object",
      "description": "Entity or object node within the investigation relationship graph.",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "label", "risk_score"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "type": "string",
          "enum": [
            "ENTITY_IP",
            "ENTITY_HOST",
            "ENTITY_USER",
            "ENTITY_PROCESS",
            "ENTITY_FILE",
            "ALERT",
            "IOC",
            "TECHNIQUE",
            "VULNERABILITY",
            "ARTIFACT"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "risk_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "graphEdge": {
      "type": "object",
      "description": "Directed relationship edge connecting two graph nodes.",
      "additionalProperties": false,
      "required": ["edge_id", "source_id", "target_id", "relation_type"],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "SPAWNED",
            "COMMUNICATED_WITH",
            "AUTHENTICATED_AS",
            "RESOLVED_TO",
            "MODIFIED",
            "ASSOCIATED_WITH",
            "INDICATES",
            "MITIGATED_BY"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "workspaceGraph": {
      "type": "object",
      "description": "Graph model consisting of nodes and directed edges.",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphNode"
          },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphEdge"
          }
        }
      }
    },
    "verifiableCitation": {
      "type": "object",
      "description": "Cryptographically verifiable source evidence citation grounding investigation claims.",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source_type",
        "source_uri",
        "content_digest",
        "raw_excerpt",
        "verified"
      ],
      "properties": {
        "citation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "SIEM_LOG",
            "EDR_TELEMETRY",
            "SANDBOX_REPORT",
            "CTI_FEED",
            "PCAP_CAPTURE",
            "IDENTITY_AUDIT"
          ]
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "$ref": "cybrik.common-defs.v1.schema.json#/$defs/sha256Digest"
        },
        "raw_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        },
        "verification_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signer_id", "algorithm", "signature_hex"],
          "properties": {
            "signer_id": { "type": "string" },
            "algorithm": { "type": "string", "enum": ["Ed25519", "ECDSA_P256", "RSA_PSS_SHA256"] },
            "signature_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{128}$|^[0-9a-fA-F]{130,512}$" }
          }
        }
      }
    },
    "reportExport": {
      "type": "object",
      "description": "Structured investigation findings report export.",
      "additionalProperties": false,
      "required": [
        "export_id",
        "export_format",
        "executive_summary",
        "findings",
        "recommended_actions",
        "exported_at",
        "exported_by"
      ],
      "properties": {
        "export_id": {
          "type": "string",
          "pattern": "^(rep|exp)_[a-zA-Z0-9._:-]{8,64}$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "export_format": {
          "type": "string",
          "enum": ["PDF", "MARKDOWN", "JSON_STIX", "HTML"]
        },
        "executive_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "findings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "recommended_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "analyst_notes": {
          "type": "string"
        },
        "exported_at": {
          "$ref": "cybrik.common-defs.v1.schema.json#/$defs/timestampUtc"
        },
        "exported_by": {
          "$ref": "cybrik.common-defs.v1.schema.json#/$defs/actor"
        }
      }
    }
  }
}
