{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cybrik.example/json-schema/cybrik.investigation-checkpoint.v1.schema.json",
  "title": "CYBRIK investigation lifecycle checkpoint v1",
  "description": "Immutable checkpoint produced by Cyber AI. Sequence is strictly increasing within an attempt. A retry creates a new attempt with sequence restarting at one and an explicit previous_attempt_id; it never mutates a prior attempt. A checkpoint cannot be appended after terminal cancellation. Status: ACCEPTED FOR IMPLEMENTATION v0.1.0 (W1-C2; not stable v1/GA) — NOT IMPLEMENTED, CI NOT WIRED.",
  "x-cybrik-status": "ACCEPTED FOR IMPLEMENTATION",
  "x-cybrik-not-accepted": false,
  "x-cybrik-contract-version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "investigation_id",
    "attempt_id",
    "attempt_number",
    "sequence",
    "tenant_id",
    "org_scope",
    "produced_by",
    "run_status",
    "stage",
    "progress",
    "checkpointed_at",
    "data_marking",
    "digest"
  ],
  "properties": {
    "checkpoint_id": {
      "$ref": "cybrik.investigation-lifecycle-common-defs.v1.schema.json#/$defs/checkpointId"
    },
    "investigation_id": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/uuid"
    },
    "attempt_id": {
      "$ref": "cybrik.investigation-lifecycle-common-defs.v1.schema.json#/$defs/attemptId"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "previous_attempt_id": {
      "$ref": "cybrik.investigation-lifecycle-common-defs.v1.schema.json#/$defs/attemptId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/tenantId"
    },
    "org_scope": {
      "$ref": "cybrik.investigation-lifecycle-common-defs.v1.schema.json#/$defs/orgScopeRef"
    },
    "produced_by": {
      "allOf": [
        {
          "$ref": "cybrik.common-defs.v1.schema.json#/$defs/actor"
        },
        {
          "type": "object",
          "required": ["tenant_id"],
          "properties": {
            "tenant_id": {
              "$ref": "cybrik.common-defs.v1.schema.json#/$defs/tenantId"
            }
          }
        }
      ]
    },
    "run_status": {
      "type": "string",
      "enum": [
        "running",
        "waiting_approval",
        "completed",
        "partial",
        "abstained",
        "denied",
        "cancelled",
        "failed"
      ]
    },
    "stage": {
      "$ref": "cybrik.investigation-lifecycle-common-defs.v1.schema.json#/$defs/checkpointStage"
    },
    "progress": {
      "$ref": "cybrik.investigation-lifecycle-common-defs.v1.schema.json#/$defs/progress"
    },
    "checkpointed_at": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/timestampUtc"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "cybrik.common-defs.v1.schema.json#/$defs/objectRef"
      },
      "maxItems": 128,
      "default": []
    },
    "data_marking": {
      "$ref": "cybrik.data-marking.v1.schema.json"
    },
    "digest": {
      "$ref": "cybrik.common-defs.v1.schema.json#/$defs/sha256Digest"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "attempt_number": {
            "type": "integer",
            "minimum": 2
          }
        },
        "required": ["attempt_number"]
      },
      "then": {
        "type": "object",
        "required": ["previous_attempt_id"],
        "properties": {
          "previous_attempt_id": {
            "$ref": "cybrik.investigation-lifecycle-common-defs.v1.schema.json#/$defs/attemptId"
          }
        }
      }
    }
  ]
}
