          "type": "boolean"
        },
        "database": {
          "type": "boolean"
        },
        "cache": {
          "type": "boolean"
        },
        "secrets": {
          "type": "boolean"
        },
        "crypto": {
          "type": "boolean"
        },
        "identity_workload_identity": {
          "type": "boolean"
