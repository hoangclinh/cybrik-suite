{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cybrik.platform-contract.v1.schema.json",
  "title": "CYBRIK Platform Contract Proposal v1",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "slots": {
      "type": "object",
      "properties": {
        "oci_image_runtime": { "type": "boolean" },
        "execution_isolation": { "type": "boolean" },
        "orchestration": { "type": "boolean" },
        "network_segmentation": { "type": "boolean" },
        "persistent_storage": { "type": "boolean" },
        "relational_datastore": { "type": "boolean" },
        "in_memory_cache": { "type": "boolean" },
        "secret_management": { "type": "boolean" },
        "identity_authentication": { "type": "boolean" },
        "observability": { "type": "boolean" },
        "ai_model_runtime": { "type": "boolean" },
        "sovereign_exchange": { "type": "boolean" },
        "artifact_offline_update": { "type": "boolean" }
      },
      "required": [
        "oci_image_runtime",
        "execution_isolation",
        "orchestration",
        "network_segmentation",
        "persistent_storage",
        "relational_datastore",
        "in_memory_cache",
        "secret_management",
        "identity_authentication",
        "observability",
        "ai_model_runtime",
        "sovereign_exchange",
        "artifact_offline_update"
      ]
    }
  },
  "required": ["version", "slots"]
}
