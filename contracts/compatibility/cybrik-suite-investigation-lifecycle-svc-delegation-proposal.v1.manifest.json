      "mint_token": false,
      "consume_token": false,
      "reason": "ACCEPTED_BINDING_GRANTS_NO_BUNDLE_READ_DELEGATION_AUTHORITY",
      "future_binding_gate": "SEPARATELY_ACCEPTED_IMPLEMENTATION_AND_CONTRACT_GATE_REQUIRED"
    }
  },
  "accepted_source_cross_check": {
    "manifest": "compatibility/cybrik-suite-investigation-lifecycle-proposal.v1.manifest.json",
    "openapi": "openapi/cybrik-ai-investigation-lifecycle-proposal.v1.openapi.yaml",
    "operation_id": "readInvestigationBundle",
    "operation_contract_state": "ACCEPTED FOR IMPLEMENTATION",
    "response_status": "200",
    "response_schema": "InvestigationBundleReadResult",
    "response_profile": "cybrik.investigation-bundle.strict-compatible.v1@0.1.1",
    "proposal_effect": "DECLINES W2-F DELEGATION AUTHORITY ONLY; DOES NOT CHANGE THE ACCEPTED BUSINESS LIFECYCLE CONTRACT"
  },
  "binding_invariants": [
    {
      "id": "LSD-1",
      "statement": "Token aud, relying-party audience and pinned self_audience equal svc:cyber-ai-lifecycle exactly."
    },
    {
      "id": "LSD-2",
      "statement": "require_mtls and require_cnf remain true; the mTLS peer certificate SHA-256 thumbprint equals token cnf x5t#S256."
    },
    {
      "id": "LSD-3",
      "statement": "The advisory body tenant equals the signed token tenant; cross-tenant mismatch is rejected."
    },
    {
      "id": "LSD-4",
      "statement": "When present, advisory body org scope equals the signed token org scope and never expands it."
    },
    {
      "id": "LSD-5",
      "statement": "The full advisory body actor equals the signed token actor; identity substitution is rejected."
    },
    {
      "id": "LSD-6",
      "statement": "The requested operation equals the signed token operation."
    },
    {
      "id": "LSD-7",
      "statement": "The token carries exactly one scope and it equals the operation mapping; extra or different scopes are rejected."
    },
    {
      "id": "LSD-8",
      "statement": "Request marking does not exceed the signed token marking on either classification or TLP axis."
    },
    {
      "id": "LSD-9",
      "statement": "Token lifetime is no more than 120 seconds and jti is single-use for its validity window."
    },
    {
      "id": "LSD-10",
      "statement": "investigation.checkpoint remains an internal Cyber AI producer write and is never delegatable by SOC."
    },
    {
      "id": "LSD-11",
      "statement": "readInvestigationBundle / investigation.bundle_read remains an accepted business lifecycle operation with accepted v0.1.1 response contract. This accepted binding grants no W2-F bundle-read delegation authority: no caller may mint and no relying party may consume a bundle-read delegation token under this accepted profile. Any future binding requires a separately accepted implementation and contract gate."
    }
  ],
