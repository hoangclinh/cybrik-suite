  "x-cybrik-status": "ACCEPTED FOR IMPLEMENTATION",
  "x-cybrik-not-accepted": false,
  "x-cybrik-implemented": false,
  "x-cybrik-packet-version": "0.1.0",
  "x-cybrik-is-bundle-tag": false,
  "audience": "svc:cyber-ai-lifecycle",
  "wire_scope": "NO NEW SERVER / NO NEW ENDPOINT. This accepted profile restricts authorization at the already accepted lifecycle seam only.",
