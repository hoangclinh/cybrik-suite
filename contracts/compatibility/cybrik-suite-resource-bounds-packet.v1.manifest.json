  "vocabulary_boundaries": {
    "investigation_budget": "The accepted W1-C2 investigation budget is distinct: it declares deadline_seconds, max_model_calls, max_tool_calls, and max_retrieved_bytes for one create request. Resource bounds conserve six additive credit dimensions across a call tree. There is no mapping between them in this packet.",
    "existing_budget_tokens": "No rename, extension, deprecation, replacement, or mapping of budget_exceeded, BUDGET_*, over_input_budget, over_output_budget, or fallbackInfo.reason=budget. Resource-accounting errors use the disjoint RES_* namespace."
  },
  "resource_model": {
    "dimensions": [
      "cpu_millis",
      "memory_byte_millis",
      "model_tokens",
      "tool_calls",
      "retrieved_bytes",
      "egress_bytes"
    ],
    "admission": "All-or-nothing; the complete child vector is subtracted from the open parent at admission.",
    "no_mint": "Spawn introduces no credit. Finite root bounds imply finite admitted fanout; depth is independent.",
    "release": "Per dimension, consumed + returned equals the target reservation current available. Only returned unused credit may join a still-open parent; consumed credit never returns.",
    "closure": "Root cancellation closes the subtree. A closed root or reservation never reopens and no release may re-mint credit."
  },
  "authority_model": {
    "tenant": "Authoritative tenant derives from the authenticated caller credential; payload tenant_id is advisory and must match.",
    "org_scope": "org_scope_ref is advisory and must match authenticated policy.",
