  "vocabulary_boundaries": {
    "investigation_budget": "The accepted W1-C2 investigation budget is distinct: it declares deadline_seconds, max_model_calls, max_tool_calls, and max_retrieved_bytes for one create request. Resource bounds conserve six additive credit dimensions across a call tree. There is no mapping between them in this packet.",
    "existing_budget_tokens": "No rename, extension, deprecation, replacement, or mapping of budget_exceeded, BUDGET_*, over_input_budget, over_output_budget, or fallbackInfo.reason=budget. Resource-accounting errors use the disjoint RES_* namespace."
  },
  "resource_model": {
    "dimensions": [
      "cpu_millis",
      "memory_byte_millis",
      "model_tokens",
      "tool_calls",
      "retrieved_bytes",
      "egress_bytes"
    ],
    "admission": "All-or-nothing; the complete child vector is subtracted from the open parent at admission.",
    "no_mint": "Spawn introduces no credit. Finite root bounds imply finite admitted fanout; depth is independent.",
    "release": "Per dimension, consumed + returned equals the target reservation current available. Only returned unused credit may join a still-open parent; consumed credit never returns.",
    "closure": "One terminal root-closure record covers normal completion and cancellation through a shared closure-reason vocabulary. At closure, final_consumed plus final_unused equals the closing grant's original bounds, the root's remaining credit becomes zero, and every still-open descendant is closed with zero remaining. The unused remainder is extinguished, returned to nobody. A closed root or reservation never reopens and no release may re-mint credit.",
    "root_binding": "Every non-grant record names the root grant whose tree it belongs to. The binding is identity-only accounting lineage with no version and no authority; a record naming a foreign root is refused.",
    "sequence": "Within one root tree, sequences start at 1 and increase by exactly 1, with no gap, no repeat, and no reordering. That dense rule means exactly one serialization point per root tree; it is a deliberate v0.1 contract limit and makes no throughput, scaling, or runtime-concurrency claim."
  },
  "authority_model": {
    "tenant": "Authoritative tenant derives from the authenticated caller credential; payload tenant_id is advisory and must match.",
    "org_scope": "org_scope_ref is advisory and must match authenticated policy.",
    "identifiers": "Grant, request, reservation, release, closure, idempotency, root, parent, version, sequence, and virtual-time fields are accounting state only.",
    "error_retriability": "The res-bounds error carries a code-derived, advisory retriable hint, true only for RES_INSUFFICIENT_REMAINDER and RES_ACTIVE_CHILDREN, where a byte-identical re-issue could later succeed because peer state changed. It grants no capacity, admission, queue position, priority, or authority, and fail_closed stays true for every code.",
    "confers_authority": false,
    "prohibition": "No member is a credential, capability, permission, delegation, or approval."
  },
