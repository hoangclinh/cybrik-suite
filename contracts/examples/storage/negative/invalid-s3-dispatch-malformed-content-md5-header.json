{
  "test_case": "invalid-s3-dispatch-malformed-content-md5-header",
  "description": "Malformed Content-MD5 header value must strictly dispatch to InvalidDigest (HTTP 400), strictly rejecting InvalidArgument or AccessDenied",
  "operation": "PutObject",
  "bucket": "cybrik-audit-vault",
  "object_key": "evidence/2026/08/incident-1042-audit-bundle.tar.gz",
  "payload": "Hello CYBRIK",
  "headers": {
    "Content-MD5": "invalid-base64-!@#$",
    "x-amz-content-sha256": "89ec141f31c4e9e085f57ea90c50ecd2e1bb74c7497d028b9bdf50cd73290e21"
  },
  "http_status": 400,
  "error_code": "InvalidDigest",
  "error_condition": "MALFORMED_HEADER_SYNTAX",
  "expected_error": {
    "http_status": 400,
    "error_code": "InvalidDigest",
    "error_condition": "MALFORMED_HEADER_SYNTAX"
  },
  "forbidden_error_codes": [
    "InvalidArgument",
    "AccessDenied"
  ]
}
