{
  "playbook_id": "pb_phishing_triage_rollback_v1",
  "name": "Phishing Triage and Host Isolation with Rollback Compensation",
  "version": "1.0.0",
  "description": "Automated email triage, malicious attachment analysis, endpoint isolation, and reverse compensation on failure.",
  "tenant_id": "tenant-acme-cyber",
  "author": {
    "type": "service",
    "id": "spiffe://cybrik.io/soc/playbook-engine",
    "tenant_id": "tenant-acme-cyber"
  },
  "risk_tier": "R2",
  "entry_step_id": "step-01-extract-email-indicators",
  "timeout_seconds": 1800,
  "concurrency_limit": 4,
  "rollback_policy": {
    "mode": "on_failure",
    "timeout_seconds": 300,
    "max_rollback_steps": 5
  },
  "tags": [
    "phishing",
    "triage",
    "containment",
    "rollback"
  ],
  "variables": {
    "suspicious_message_id": "msg-2026-981142",
    "target_endpoint_hostname": "wkst-secops-042"
  },
  "steps": [
    {
      "step_id": "step-01-extract-email-indicators",
      "name": "Extract Indicators from Suspicious Email",
      "description": "Parse headers, URLs, and attachment hashes from quarantined message.",
      "step_type": "action",
      "risk_tier": "R0",
      "next_step_id": "step-02-evaluate-threat-score",
      "action": {
        "action_id": "extract_email_artifacts",
        "capability_id": "cap-email-parser",
        "target": "eml://inbox/msg-2026-981142",
        "target_tenant_id": "tenant-acme-cyber",
        "parameters": {
          "extract_attachments": true,
          "extract_urls": true
        },
        "idempotency_key": "idemp-parse-msg-2026-981142"
      },
      "retry_policy": {
        "max_retries": 3,
        "initial_backoff_seconds": 1.0,
        "backoff_multiplier": 2.0,
        "max_backoff_seconds": 30.0,
        "retryable_errors": [
          "ServiceUnavailable",
          "GatewayTimeout"
        ]
      },
      "timeout_seconds": 60
    },
    {
      "step_id": "step-02-evaluate-threat-score",
      "name": "Evaluate Threat Severity Condition",
      "description": "Check if combined malicious score exceeds high severity threshold.",
      "step_type": "condition",
      "risk_tier": "R0",
      "depends_on": [
        "step-01-extract-email-indicators"
      ],
      "condition": {
        "expression": "artifacts.threat_score >= 0.85",
        "dialect": "cel",
        "on_true_step_id": "step-03-isolate-endpoint",
        "on_false_step_id": "step-05-notify-security-analyst"
      }
    },
    {
      "step_id": "step-03-isolate-endpoint",
      "name": "Isolate Compromised Workstation",
      "description": "Execute network isolation on target endpoint via EDR agent.",
      "step_type": "action",
      "risk_tier": "R2",
      "depends_on": [
        "step-02-evaluate-threat-score"
      ],
      "next_step_id": "step-04-quarantine-mailbox-message",
      "action": {
        "action_id": "isolate_host_network",
        "capability_id": "cap-edr-containment",
        "target": "edr://host/wkst-secops-042",
        "target_tenant_id": "tenant-acme-cyber",
        "parameters": {
          "isolation_scope": "full_network_cut",
          "allow_edr_tunnel": true
        },
        "idempotency_key": "idemp-isolate-wkst-secops-042"
      },
      "retry_policy": {
        "max_retries": 2,
        "initial_backoff_seconds": 2.0,
        "backoff_multiplier": 2.0,
        "max_backoff_seconds": 60.0
      },
      "rollback_step": {
        "step_id": "rb-01-unisolate-host",
        "action_id": "unisolate_host_network",
        "compensation_type": "inverse_action",
        "parameters": {
          "host_id": "wkst-secops-042"
        },
        "timeout_seconds": 120
      },
      "timeout_seconds": 120
    },
    {
      "step_id": "step-04-quarantine-mailbox-message",
      "name": "Purge Malicious Email Across Organization",
      "description": "Delete or quarantine matching message across tenant mailboxes.",
      "step_type": "action",
      "risk_tier": "R2",
      "depends_on": [
        "step-03-isolate-endpoint"
      ],
      "next_step_id": "step-05-notify-security-analyst",
      "action": {
        "action_id": "purge_email_by_message_id",
        "capability_id": "cap-o365-admin",
        "target": "o365://tenant/tenant-acme-cyber",
        "target_tenant_id": "tenant-acme-cyber",
        "parameters": {
          "message_id": "msg-2026-981142"
        },
        "idempotency_key": "idemp-purge-msg-2026-981142"
      },
      "timeout_seconds": 180
    },
    {
      "step_id": "step-05-notify-security-analyst",
      "name": "Notify On-Call SOC Incident Commander",
      "description": "Send formatted notification and case context to incident channel.",
      "step_type": "notification",
      "risk_tier": "R0",
      "depends_on": [
        "step-04-quarantine-mailbox-message"
      ]
    }
  ],
  "data_marking": {
    "classification": "confidential",
    "tlp": "TLP:AMBER",
    "handling": [
      "secops-internal-only"
    ]
  },
  "created_at": "2026-09-05T02:00:00Z",
  "digest": "sha256:2127d719013c1766950188d0f41a28acfd604ab1c61535cd4804d96e08c9bda7"
}
