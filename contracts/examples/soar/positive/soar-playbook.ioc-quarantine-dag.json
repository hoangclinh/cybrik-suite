      ],
      "action": {
        "action_id": "lookup_ip_whois_vt",
        "capability_id": "cap-cti-enricher",
        "target": "cti://reputation/ip/198.51.100.77",
        "parameters": {
          "ip": "198.51.100.77"
        },
        "target_tenant_id": "tenant-acme-cyber"
      }
    },
    {
